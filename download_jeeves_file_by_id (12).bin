<script>
// === НАСТРОЙКИ ===
// Номер WhatsApp для заказов (в формате 7XXXXXXXXXXX). Telegram — ник без @, если нужен.
const PHONE = { whatsapp: "79118974410", telegram: "" };
const PAGE_SIZE = 60;
</script>
<script src="products.js"></script>
<script>
const SV = (d) => '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">' + d + '</svg>';
const ICONS = {
  radiator: SV('<rect x="9" y="12" width="30" height="22" rx="3"/><path d="M15 17v12M21 17v12M27 17v12M33 17v12M14 34v5M34 34v5"/>'),
  convector: SV('<rect x="8" y="18" width="32" height="13" rx="3"/><path d="M12 23h24M12 27h24M20 14h8M24 14v4"/>'),
  pipe: SV('<rect x="8" y="18" width="26" height="12" rx="2"/><circle cx="40" cy="24" r="4"/>'),
  tee: SV('<path d="M24 12v24M10 24h28"/>'),
  elbow: SV('<path d="M12 40V20a8 8 0 0 1 8-8h16"/>'),
  reducer: SV('<circle cx="16" cy="24" r="8"/><circle cx="33" cy="24" r="5"/><path d="M24 21h4M24 27h4"/>'),
  cross: SV('<path d="M24 10v28M10 24h28"/>'),
  plug: SV('<path d="M14 24a10 10 0 0 1 20 0M19 24v9a5 5 0 0 0 10 0v-9"/>'),
  coupling: SV('<rect x="10" y="19" width="10" height="10" rx="2"/><rect x="28" y="19" width="10" height="10" rx="2"/><path d="M20 24h8"/>'),
  nipple: SV('<rect x="14" y="21" width="20" height="6" rx="2"/><path d="M19 21v6M24 21v6M29 21v6"/>'),
  ballvalve: SV('<circle cx="24" cy="29" r="8"/><path d="M24 21v-8M17 9h14M19 29h10"/>'),
  valve: SV('<path d="M14 23h20v9H14zM24 23v-9M17 13h14"/>'),
  filter: SV('<path d="M12 17h24v5l-9 7v10h-6V29l-9-7z"/>'),
  meter: SV('<rect x="10" y="17" width="28" height="15" rx="3"/><path d="M16 24h4M23 24h4M30 24h4"/>'),
  collector: SV('<rect x="7" y="15" width="34" height="8" rx="2"/><path d="M13 23v11M21 23v11M29 23v11M37 23v11"/>'),
  pump: SV('<circle cx="24" cy="24" r="11"/><circle cx="24" cy="24" r="3.5"/><path d="M24 13v7M24 28v7M13 24h7M28 24h7"/>'),
  tank: SV('<path d="M14 17c0-5 20-5 20 0v15c0 5-20 5-20 0zM14 24h20M18 34v6M30 34v6"/>'),
  boiler: SV('<rect x="11" y="10" width="26" height="28" rx="4"/><path d="M17 17h14M24 30c-3 2-3 5 0 6.5 3-1.5 3-4.5 0-6.5z"/>'),
  heater: SV('<rect x="15" y="9" width="18" height="30" rx="9"/><path d="M24 19c-3 2.4-3 6 0 7.8 3-1.8 3-5.4 0-7.8zM19 32h10"/>'),
  chimney: SV('<circle cx="24" cy="24" r="12"/><circle cx="24" cy="24" r="6"/>'),
  thermostat: SV('<circle cx="24" cy="27" r="10"/><path d="M24 27l6.5-6.5M24 17v-5M15 11h18"/>'),
  sensor: SV('<path d="M24 42V17"/><circle cx="24" cy="13" r="3.5"/><path d="M31 7c4 3 4 8 0 11M17 7c-4 3-4 8 0 11"/>'),
  controller: SV('<rect x="9" y="13" width="30" height="22" rx="3"/><path d="M15 20h11M15 28h5"/><circle cx="31" cy="19" r="2"/><circle cx="31" cy="28" r="2"/>'),
  underfloor: SV('<path d="M8 15h32M8 22h32M8 29h32M8 36h32"/>'),
  sealant: SV('<path d="M19 14h10v20a2 2 0 0 1-2 2h-6a2 2 0 0 1-2-2zM24 14V8h6"/>'),
  hose: SV('<path d="M10 25c5-6 9 6 14 0s9-6 14 0"/><rect x="4" y="21" width="8" height="8" rx="1.5"/><rect x="36" y="21" width="8" height="8" rx="1.5"/>'),
  tray: SV('<rect x="10" y="13" width="28" height="22" rx="4"/><circle cx="24" cy="27" r="4"/><path d="M14 19h20"/>'),
  tool: SV('<path d="M28 12a6 6 0 0 1 8 8l-4 4 4 4-6 6-4-4-4 4a6 6 0 0 1-8-8l4-4z"/>'),
  bracket: SV('<path d="M16 10v9a8 8 0 0 0 16 0v-9M24 27v11"/>'),
  part: SV('<path d="M12 19h6v10h-6zM30 19h6v10h-6zM18 21h12v6H18z"/>')
};
const CATICON = { "Котельное оборудование": "boiler", "Арматура для котлов": "valve", "Трубы и фитинги": "pipe", "Арматура трубопроводная": "ballvalve", "Арматура терморегулирующая": "thermostat", "Теплый пол и кабели": "underfloor", "Счетчики и фильтры воды": "meter", "Защита от протечек": "controller", "Насосное оборудование": "pump", "Уплотнители и герметики": "sealant", "Расширительные баки": "tank", "Стабилизаторы и автоматика": "controller", "Промышленная арматура": "valve", "STOUT": "part" };
const ICON_RULES = [["клапан", "valve"], ["вентиль", "valve"], ["редуктор", "valve"], ["затвор", "valve"], ["воздухоотвод", "valve"], ["смесительн", "valve"], ["обратн", "valve"], ["предохран", "valve"], ["кран", "ballvalve"], ["радиатор", "radiator"], ["полотенцесушитель", "radiator"], ["конвектор", "convector"], ["коллектор", "collector"], ["гребенк", "collector"], ["гидрострелк", "tank"], ["насос", "pump"], ["дымоход", "chimney"], ["дымоудал", "chimney"], ["коакс", "chimney"], ["оголовок", "chimney"], ["водонагреватель", "heater"], ["бойлер", "heater"], ["котел", "boiler"], ["котёл", "boiler"], ["котло", "boiler"], ["горелк", "boiler"], ["бак", "tank"], ["бачок", "tank"], ["теплый пол", "underfloor"], ["тёплый пол", "underfloor"], ["нагревательн", "underfloor"], ["кабель", "underfloor"], ["теплоносит", "sealant"], ["герметик", "sealant"], ["анаэроб", "sealant"], ["паста", "sealant"], ["фум", "sealant"], ["лен", "sealant"], ["смазк", "sealant"], ["подводк", "hose"], ["шланг", "hose"], ["гофр", "hose"], ["счетчик", "meter"], ["счётчик", "meter"], ["манометр", "meter"], ["термометр", "meter"], ["термостат", "thermostat"], ["терморегул", "thermostat"], ["датчик", "sensor"], ["зонд", "sensor"], ["zont", "controller"], ["контроллер", "controller"], ["автоматик", "controller"], ["стабилизатор", "controller"], ["реле", "controller"], ["сервопривод", "controller"], ["фильтр", "filter"], ["труба", "pipe"], ["трубк", "pipe"], ["трубы", "pipe"], ["канализац", "pipe"], ["штанг", "pipe"], ["лоток", "tray"], ["трап", "tray"], ["сифон", "tray"], ["инструмент", "tool"], ["клещи", "tool"], ["насадк", "tool"], ["ключ", "tool"], ["тройник", "tee"], ["крестовин", "cross"], ["угольник", "elbow"], ["уголок", "elbow"], ["отвод", "elbow"], ["колен", "elbow"], ["обвод", "elbow"], ["заглушк", "plug"], ["пробк", "plug"], ["муфт", "coupling"], ["американк", "coupling"], ["разъем", "coupling"], ["соединит", "coupling"], ["соединен", "coupling"], ["адаптер", "reducer"], ["переход", "reducer"], ["редукц", "reducer"], ["вставк", "reducer"], ["ниппель", "nipple"], ["футорк", "nipple"], ["сгон", "nipple"], ["штуцер", "nipple"], ["косичк", "nipple"], ["гайк", "nipple"], ["шпильк", "nipple"], ["прокладк", "part"], ["хомут", "bracket"], ["крепл", "bracket"], ["кронштейн", "bracket"], ["скоб", "bracket"], ["профиль", "bracket"], ["фланец", "part"], ["узел", "part"], ["комплект", "part"], ["принадлежност", "part"], ["компенсатор", "part"], ["седелк", "part"], ["инсталляц", "part"]];

// --- фото (загружаются лениво из photos.js: ключ pp{стр}_{xref} -> base64) ---
let PHOTOS = window.PHOTOS || {};
let photosLoaded = !!window.PHOTOS;
function ensurePhotos(cb){
  if (photosLoaded) { cb && cb(); return; }
  photosLoaded = true;
  const s = document.createElement('script');
  s.src = 'photos.js';
  s.onload = () => { PHOTOS = window.PHOTOS || {}; cb && cb(); };
  s.onerror = () => { cb && cb(); };
  document.head.appendChild(s);
}

const PROD = {};
PRODUCTS.forEach(p => { PROD[p.id] = p; });

function esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function iconFor(p){
  const t = (p.n + ' ' + p.c + ' ' + (p.b||'')).toLowerCase();
  for (const [k,ic] of ICON_RULES) if (t.indexOf(k) >= 0) return ic;
  return CATICON[p.c] || 'part';
}
function phInner(p){
  if (p.p && PHOTOS[p.p]) return '<img src="' + PHOTOS[p.p] + '" alt="" loading="lazy" onerror="this.remove()">';
  return '<span class="ph-ic">' + ICONS[iconFor(p)] + '</span>';
}

let cart = {};
try { cart = JSON.parse(localStorage.getItem('plumbing_cart') || '{}'); } catch(e) { cart = {}; }
let st = { q:'', cat:'Все', brand:'', sort:'def', shown:PAGE_SIZE };
try { const f = JSON.parse(localStorage.getItem('plumbing_form') || '{}'); if (f) window.__form = f; } catch(e) {}

const CAT_LABEL = { 'STOUT': 'STOUT · основной каталог' };
const CAT_ICON2 = { 'STOUT':'part', 'Трубы и фитинги':'pipe', 'Котельное оборудование':'boiler',
  'Арматура для котлов':'valve', 'Арматура трубопроводная':'ballvalve', 'Арматура терморегулирующая':'thermostat',
  'Теплый пол и кабели':'underfloor', 'Счетчики и фильтры воды':'meter', 'Защита от протечек':'controller',
  'Насосное оборудование':'pump', 'Уплотнители и герметики':'sealant', 'Расширительные баки':'tank',
  'Стабилизаторы и автоматика':'controller', 'Промышленная арматура':'valve' };
const CAT_GRAD = ['linear-gradient(135deg,#1466d9,#0aa2c0)','linear-gradient(135deg,#0c2440,#1466d9)',
  'linear-gradient(135deg,#ff8a1e,#f5576c)','linear-gradient(135deg,#0aa2c0,#2dd4bf)',
  'linear-gradient(135deg,#6366f1,#1466d9)','linear-gradient(135deg,#e9740a,#ffb469)',
  'linear-gradient(135deg,#0d4cad,#6366f1)','linear-gradient(135deg,#059669,#34d399)',
  'linear-gradient(135deg,#7c3aed,#a78bfa)','linear-gradient(135deg,#0891b2,#22d3ee)',
  'linear-gradient(135deg,#db2777,#f472b6)','linear-gradient(135deg,#475569,#94a3b8)',
  'linear-gradient(135deg,#b45309,#f59e0b)','linear-gradient(135deg,#166534,#4ade80)'];

function plural(n){ const a = n % 100, b = a % 10;
  if (a > 10 && a < 20) return 'товаров';
  if (b === 1) return 'товар';
  if (b >= 2 && b <= 4) return 'товара';
  return 'товаров'; }

function counts(){
  const m = {};
  PRODUCTS.forEach(p => { m[p.c] = (m[p.c]||0) + 1; });
  return Object.keys(m).sort((a,b)=>m[b]-m[a]).map(c => ({ c, n: m[c] }));
}

function renderCatTiles(){
  document.getElementById('catGrid').innerHTML = counts().map((o,i) => `
    <button class="cat-tile" data-cat="${esc(o.c)}" style="background:${CAT_GRAD[i % CAT_GRAD.length]}">
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">${ICONS[CAT_ICON2[o.c] || 'part']}</svg>
      <b>${esc(CAT_LABEL[o.c] || o.c)}</b><span>${o.n.toLocaleString('ru-RU')} ${plural(o.n)}</span>
    </button>`).join('');
}

function topBrands(){
  const m = {};
  PRODUCTS.forEach(p => { if (p.b) m[p.b] = (m[p.b]||0) + 1; });
  return Object.keys(m).filter(b => m[b] >= 60).sort((a,b)=>m[b]-m[a]).slice(0, 20);
}

function renderBrands(){
  document.getElementById('brandRow').innerHTML = topBrands().map(b =>
    `<button class="bchip${st.brand===b && !st.q ? ' active':''}" data-brand="${esc(b)}">${esc(b)}</button>`).join('');
}

function renderChips(){
  const cs = ['Все'].concat(counts().map(o=>o.c));
  document.getElementById('chips').innerHTML = cs.map(c =>
    `<button class="chip${st.cat===c && !st.q && !st.brand ? ' active':''}" data-chip="${esc(c)}">${esc(c==='Все' ? 'Все товары' : (CAT_LABEL[c]||c))}</button>`).join('');
}

function filtered(){
  let list = PRODUCTS;
  if (st.q) {
    const q = st.q.toLowerCase();
    list = list.filter(p => (p.n+' '+p.s+' '+p.c+' '+p.b+' '+p.a).toLowerCase().includes(q));
  } else {
    if (st.cat !== 'Все') list = list.filter(p => p.c === st.cat);
    if (st.brand) list = list.filter(p => p.b === st.brand);
  }
  if (st.sort === 'name') list = list.slice().sort((a,b)=>a.n.localeCompare(b.n,'ru'));
  if (st.sort === 'brand') list = list.slice().sort((a,b)=>(a.b||'').localeCompare(b.b||'','ru')||a.n.localeCompare(b.n,'ru'));
  return list;
}

function cardHTML(p){
  const inCart = cart[p.id] || 0;
  const ctl = inCart
    ? `<div class="stepper"><button data-dec="${p.id}">−</button><span>${inCart}</span><button data-inc="${p.id}">+</button></div>`
    : `<button class="addbtn" data-add="${p.id}">В корзину</button>`;
  return `
  <div class="card" data-open="${p.id}">
    <div class="ph">${phInner(p)}</div>
    <div class="cbody">
      <div class="cbrand">${esc(p.b||'')}</div>
      <div class="cname">${esc(p.n)}</div>
      <div class="csize">${esc(p.s||'')}</div>
      <div class="cfoot"><span class="cprice">Цена по запросу</span>${ctl}</div>
    </div>
  </div>`;
}

function render(){
  const list = filtered();
  document.getElementById('counter').textContent = `Показано ${Math.min(list.length, st.shown).toLocaleString('ru-RU')} из ${list.length.toLocaleString('ru-RU')} позиций`;
  document.getElementById('empty').style.display = list.length ? 'none' : 'block';
  document.getElementById('moreBtn').style.display = list.length > st.shown ? 'block' : 'none';
  document.getElementById('grid').innerHTML = list.slice(0, st.shown).map(cardHTML).join('');
  document.getElementById('catTitle').textContent = st.q ? `Поиск: «${st.q}»` : (st.brand ? st.brand : (st.cat==='Все' ? 'Все товары' : (CAT_LABEL[st.cat]||st.cat)));
  renderChips(); renderBrands();
}

/* ---------- события ---------- */
document.getElementById('q').addEventListener('input', e => {
  st.q = e.target.value.trim(); st.cat = 'Все'; st.brand = ''; st.shown = PAGE_SIZE; render();
});
document.getElementById('sortSel').addEventListener('change', e => { st.sort = e.target.value; render(); });
document.getElementById('moreBtn').addEventListener('click', () => { st.shown += PAGE_SIZE; render(); });

document.getElementById('catGrid').addEventListener('click', e => {
  const t = e.target.closest('[data-cat]'); if (!t) return;
  st.cat = t.dataset.cat; st.q = ''; st.brand = ''; document.getElementById('q').value = '';
  st.shown = PAGE_SIZE; render();
  document.getElementById('catalog').scrollIntoView({behavior:'smooth'});
});
document.getElementById('chips').addEventListener('click', e => {
  const t = e.target.closest('[data-chip]'); if (!t) return;
  st.cat = t.dataset.chip; st.q = ''; st.brand = ''; document.getElementById('q').value = '';
  st.shown = PAGE_SIZE; render(); window.scrollTo(0, 0);
});
document.getElementById('brandRow').addEventListener('click', e => {
  const t = e.target.closest('[data-brand]'); if (!t) return;
  const b = t.dataset.brand;
  if (st.brand === b) { st.brand = ''; } else { st.brand = b; st.q = ''; document.getElementById('q').value = ''; }
  st.cat = 'Все'; st.shown = PAGE_SIZE; render();
});

document.getElementById('grid').addEventListener('click', e => {
  const inc = e.target.closest('[data-inc]');
  if (inc) { change(+inc.dataset.inc, 1); return; }
  const dec = e.target.closest('[data-dec]');
  if (dec) { change(+dec.dataset.dec, -1); return; }
  const add = e.target.closest('[data-add]');
  if (add) { change(+add.dataset.add, 1); return; }
  const card = e.target.closest('[data-open]');
  if (card) openProd(+card.dataset.open);
});

/* ---------- корзина ---------- */
function change(id, d){
  cart[id] = (cart[id]||0) + d;
  if (cart[id] <= 0) delete cart[id];
  save(); updateCount(); render();
  if (document.getElementById('panel').classList.contains('show')) renderCart();
}
function save(){ localStorage.setItem('plumbing_cart', JSON.stringify(cart)); }
function updateCount(){
  const n = Object.values(cart).reduce((a,b)=>a+b, 0);
  document.getElementById('cartCount').textContent = n;
  document.getElementById('fabCount').textContent = n;
}
function openCart(){ document.getElementById('ov').classList.add('show'); document.getElementById('panel').classList.add('show'); renderCart(); }
function closeCart(){ document.getElementById('ov').classList.remove('show'); document.getElementById('panel').classList.remove('show'); }
document.getElementById('cartBtn').addEventListener('click', openCart);
document.getElementById('fab').addEventListener('click', openCart);
document.getElementById('closeCart').addEventListener('click', closeCart);
document.getElementById('ov').addEventListener('click', closeCart);

function renderCart(){
  const ids = Object.keys(cart).map(Number);
  document.getElementById('cbody').innerHTML = ids.length ? ids.map(id => {
    const p = PROD[id]; if (!p) return '';
    return `
    <div class="citem">
      <div class="cthumb">${phInner(p)}</div>
      <div class="n">
        <div class="nm">${esc(p.n)}${p.s ? ' · ' + esc(p.s) : ''}</div>
        <div class="pp">${esc(p.b||'')} · арт. ${esc(p.a)}</div>
      </div>
      <div class="qty">
        <button data-cdec="${id}">−</button><b>${cart[id]}</b><button data-cinc="${id}">+</button>
      </div>
      <button class="del" data-cdel="${id}" title="Удалить">✕</button>
    </div>`;
  }).join('') : `<div class="empty-cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1.6"/><circle cx="19" cy="21" r="1.6"/><path d="M2 3h3l2.6 12.4a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 2-1.6L22 7H6"/></svg>Корзина пуста<br><small>Выберите товары в каталоге</small></div>`;
  document.getElementById('pfoot').style.display = ids.length ? 'block' : 'none';
}
document.getElementById('cbody').addEventListener('click', e => {
  const i = e.target.closest('[data-cinc]'); if (i) { change(+i.dataset.cinc, 1); return; }
  const d = e.target.closest('[data-cdec]'); if (d) { change(+d.dataset.cdec, -1); return; }
  const x = e.target.closest('[data-cdel]'); if (x) { delete cart[+x.dataset.cdel]; save(); updateCount(); renderCart(); render(); }
});

/* ---------- модалка товара ---------- */
function openProd(id){
  const p = PROD[id]; if (!p) return;
  document.getElementById('pmodal').innerHTML = `
    <button class="pm-close" id="pmClose">✕</button>
    <div class="pm-in">
      <div class="pm-ph">${phInner(p)}</div>
      <div class="pm-brand">${esc(p.b||'')}</div>
      <div class="pm-name">${esc(p.n)}${p.s ? ' — ' + esc(p.s) : ''}</div>
      <div class="pm-rows">
        <div class="pm-row"><span>Артикул</span><b>${esc(p.a)}</b></div>
        <div class="pm-row"><span>Размер</span><b>${esc(p.s || '—')}</b></div>
        <div class="pm-row"><span>Категория</span><b>${esc(CAT_LABEL[p.c]||p.c)}</b></div>
      </div>
      <div class="pm-price">Цена по запросу</div>
      <div class="pm-actions">
        <div class="stepper"><button id="pmDec">−</button><span id="pmQty">${cart[id]||0}</span><button id="pmInc">+</button></div>
        <button class="addbtn" id="pmAdd">Добавить в корзину</button>
      </div>
    </div>`;
  document.getElementById('modalOv').classList.add('show');
  document.getElementById('pmClose').onclick = closeProd;
  document.getElementById('modalOv').onclick = e => { if (e.target.id === 'modalOv') closeProd(); };
  let qty = cart[id] || 0;
  const ref = () => { document.getElementById('pmQty').textContent = qty; };
  document.getElementById('pmInc').onclick = () => { qty++; ref(); };
  document.getElementById('pmDec').onclick = () => { if (qty > 0) qty--; ref(); };
  document.getElementById('pmAdd').onclick = () => {
    if (qty > 0) { cart[id] = qty; save(); updateCount(); render(); }
    closeProd();
  };
}
function closeProd(){ document.getElementById('modalOv').classList.remove('show'); }

/* ---------- форма и заказ ---------- */
const formEls = ['fName','fPhone','fNote'];
formEls.forEach(id => {
  const el = document.getElementById(id);
  if (window.__form && window.__form[id]) el.value = window.__form[id];
  el.addEventListener('input', () => {
    const f = {}; formEls.forEach(x => f[x] = document.getElementById(x).value);
    localStorage.setItem('plumbing_form', JSON.stringify(f));
  });
});

function orderText(){
  const name = document.getElementById('fName').value.trim() || '—';
  const phone = document.getElementById('fPhone').value.trim() || '—';
  const note = document.getElementById('fNote').value.trim() || '—';
  const ids = Object.keys(cart).map(Number);
  const lines = [`🛒 ЗАКАЗ — SantehLux`, `Кто: ${name}`, `Телефон: ${phone}`, `Объект/примечание: ${note}`, ``, `Товары (${ids.length}):`];
  ids.forEach((id, i) => {
    const p = PROD[id]; if (!p) return;
    lines.push(`${i+1}. ${p.n}${p.s ? ' — ' + p.s : ''}`);
    lines.push(`   ${p.b||''} · арт. ${p.a} · ${cart[id]} шт.`.trim());
  });
  return lines.join('\n');
}

function sendOrder(kind){
  if (!Object.keys(cart).length) { alert('Корзина пуста'); return; }
  const t = orderText();
  if (kind === 'copy') {
    navigator.clipboard.writeText(t).then(() => alert('Текст заказа скопирован — вставьте в мессенджер'))
      .catch(() => alert('Не удалось скопировать'));
    return;
  }
  if (kind === 'wa' && PHONE.whatsapp) {
    window.open('https://wa.me/' + PHONE.whatsapp.replace(/\D/g,'') + '?text=' + encodeURIComponent(t), '_blank');
  } else if (kind === 'tg' && PHONE.telegram) {
    window.open('https://t.me/' + PHONE.telegram.replace('@','') + '?text=' + encodeURIComponent(t), '_blank');
  } else {
    alert('Telegram не настроен. Впишите ник в файле index.html (блок PHONE) или отправьте заказ через WhatsApp.');
  }
}
document.getElementById('btnWa').addEventListener('click', () => sendOrder('wa'));
document.getElementById('btnTg').addEventListener('click', () => sendOrder('tg'));
document.getElementById('btnCopy').addEventListener('click', () => sendOrder('copy'));

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') { closeCart(); closeProd(); }
});

renderCatTiles();
render();
updateCount();
if (!photosLoaded && PRODUCTS.some(p => p.p)) ensurePhotos(() => render());
</script>
</body>
</html>
